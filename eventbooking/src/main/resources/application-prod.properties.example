# ===================================================
# BẢN MẪU — copy thành application-prod.properties
# rồi điền giá trị thật (KHÔNG commit file thật)
# ===================================================

# Database MySQL
DB_URL=jdbc:mysql://localhost:3306/event_booking_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# JWT (Base64, tối thiểu 32 bytes) — openssl rand -base64 32
JWT_SECRET=YOUR_BASE64_SECRET
ACCESS_TOKEN_MS=1800000
REFRESH_TOKEN_MS=604800000

# Link FE đặt lại mật khẩu
FE_RESET_URL=https://your-domain.com/reset-password
